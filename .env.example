# Nothing here is read unless FLY_ALLOW_BROWSER is 1.

# Required before a browser will open against a real site at all. A button
# in a web page is not a strong enough guard for that on its own.
FLY_ALLOW_BROWSER=0

# Drops the domain allowlist in roam.py and leaves only the URL blocklist
# behind it. Do not leave this on for an unattended public stream.
FLY_ROAM_OPEN=0

# Overrides the port and bind host roam.py listens on.
PORT=4660
FLY_HOST=127.0.0.1
